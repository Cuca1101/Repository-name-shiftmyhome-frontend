# Copy to .env for local development (never commit .env)

VITE_MAPBOX_TOKEN=
# Browser key for address autocomplete only (Places API New). Do not commit the real key.
VITE_GOOGLE_MAPS_API_KEY=
# UK postcode lookup that lists house numbers (Ideal Postcodes). Do not commit the real key.
VITE_IDEAL_POSTCODES_API_KEY=
# SnapAddress postcode lookup. Store the real key only as the Supabase secret SNAPADDRESS_API_KEY. Never use a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Stripe publishable key only (pk_test_… or pk_live_…). Secret key sk_* belongs in Supabase Edge Function secrets only — see docs/supabase-stripe-secrets.md
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional analytics / marketing (production build / hosting env)
VITE_GA_MEASUREMENT_ID=G-JHFQTSQRTL
VITE_META_PIXEL_ID=

# Google Ads conversion tracking (from Google Ads → Goals → Conversions)
# Production: .env.production (committed) and/or Cloudflare Pages env vars.
VITE_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX
VITE_GOOGLE_ADS_PURCHASE_LABEL=XXXXXXXXX

# Call history runs in Cloudflare Pages Functions. Do not put these in Vite, VITE_*, or the browser.
# Add them as encrypted secrets: Cloudflare → Workers & Pages → this project → Settings →
# Environment variables → Encrypt, for both Production and Preview.
#
# Placeholder names only. Replace these in Cloudflare, not in this file.
# MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
# MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MICROSOFT_CLIENT_SECRET=your-client-secret
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-or-publishable-key
# If those two names are unset, the function uses the existing public
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY already configured for the website.
# Never set either name to the Supabase service-role key.
#
# Local `npm run dev` runs these same functions. Put the same names in a gitignored
# .dev.vars file in the project root. Do not commit that file.
#
# Microsoft Graph application permission required for history: CallRecords.Read.All,
# with admin consent. The secret stays on the server. Call with Teams does not need it.
# Do not change the existing Teams Phone number or calling-plan configuration here.
