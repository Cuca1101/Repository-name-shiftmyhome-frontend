# Copy to .env for local development (never commit .env)

VITE_MAPBOX_TOKEN=
# Browser key for address autocomplete only (Places API New). Do not commit the real key.
VITE_GOOGLE_MAPS_API_KEY=
# UK postcode lookup that lists house numbers (Ideal Postcodes). Do not commit the real key.
VITE_IDEAL_POSTCODES_API_KEY=
# SnapAddress postcode lookup. Store the real key only as the Supabase secret SNAPADDRESS_API_KEY. Never use a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Stripe publishable key only (pk_test_… or pk_live_…). Secret key sk_* belongs in Supabase Edge Function secrets only — see docs/supabase-stripe-secrets.md
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional analytics / marketing (production build / hosting env)
VITE_GA_MEASUREMENT_ID=G-JHFQTSQRTL
VITE_META_PIXEL_ID=

# Google Ads conversion tracking (from Google Ads → Goals → Conversions)
# Production: .env.production (committed) and/or Cloudflare Pages env vars.
VITE_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX
VITE_GOOGLE_ADS_PURCHASE_LABEL=XXXXXXXXX

# Call history runs in Cloudflare Pages Functions. Do not put these in Vite, VITE_*, or the browser.
# Add them as encrypted secrets: Cloudflare → Workers & Pages → this project → Settings →
# Environment variables → Encrypt, for both Production and Preview.
#
# Placeholder names only. Replace these in Cloudflare, not in this file.
# AWS_REGION=eu-west-2
# AWS_CONNECT_INSTANCE_ID=00000000-0000-0000-0000-000000000000
# AWS_CONNECT_RECORDINGS_BUCKET=your-recordings-bucket
# AWS_CONNECT_RECORDINGS_PREFIX=your-recordings-prefix/
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-or-publishable-key
# AWS_SESSION_TOKEN=temporary-session-token
#
# Local `npm run dev` runs these same functions. Put the same names in a gitignored
# .dev.vars file in the project root. Do not commit that file.
# AWS_SESSION_TOKEN is only for temporary credentials. Leave it unset for a long-lived access key.
# AWS_CONNECT_INSTANCE_ID must be the full instance UUID from Amazon Connect (8-4-4-4-12).
# The function reads AWS_REGION from the server environment and accepts only eu-west-2.
#
# How to copy the bucket and prefix:
# 1. Amazon Connect → your instance → Data storage → Call recordings.
#    Use the S3 bucket name shown there as AWS_CONNECT_RECORDINGS_BUCKET.
#    Use the path shown there as AWS_CONNECT_RECORDINGS_PREFIX.
# 2. Or open an existing recording object in S3. The bucket name is
#    AWS_CONNECT_RECORDINGS_BUCKET. The prefix is every folder before the file name.
#    For this instance the recording objects use the prefix CallRecordings/ at the
#    bucket root. Copy that prefix exactly. The server still checks the object
#    returned by DescribeContact against these two secrets and refuses anything else.
#
# IAM for the access key. Do not put the key in this repository.
# - connect:SearchContacts and connect:DescribeContact on the instance
# - connect:DescribeQueue on arn:aws:connect:eu-west-2:account:instance/INSTANCE_ID/queue/*
# - connect:DescribeUser on arn:aws:connect:eu-west-2:account:instance/INSTANCE_ID/agent/*
# - s3:GetObject on arn:aws:s3:::your-recordings-bucket/your-recordings-prefix*
# - kms:Decrypt is required. Recordings are encrypted with the AWS-managed key
#   alias/aws/connect in eu-west-2. Grant kms:Decrypt on that key, for example
#   arn:aws:kms:eu-west-2:account:alias/aws/connect, with kms:ViaService set to
#   s3.eu-west-2.amazonaws.com. An AWS-managed key still needs this permission
#   on the caller that downloads the object.
