# Copy to .env for local development (never commit .env)

VITE_MAPBOX_TOKEN=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Stripe publishable key only (pk_test_… or pk_live_…). Secret key sk_* belongs in Supabase Edge Function secrets only — see docs/supabase-stripe-secrets.md
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional analytics / marketing (production build / hosting env)
VITE_GA_MEASUREMENT_ID=G-JHFQTSQRTL
VITE_META_PIXEL_ID=

# Google Ads conversion tracking (from Google Ads → Goals → Conversions)
# Production: .env.production (committed) and/or Cloudflare Pages env vars.
VITE_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX
VITE_GOOGLE_ADS_PURCHASE_LABEL=XXXXXXXXX
